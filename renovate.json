{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":disableDependencyDashboard"],
  "semanticCommits": "enabled",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group Nix flake input updates into a single PR",
      "matchManagers": ["nix"],
      "matchUpdateTypes": ["digest"],
      "groupName": "Nix flake inputs",
      "groupSlug": "nix-flake-inputs"
    },
    {
      "description": "Group non-major CI action updates in .forgejo/workflows; major bumps get their own PR",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["digest", "patch", "minor"],
      "groupName": "CI workflow actions",
      "groupSlug": "ci-workflow-actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the minimum Zig compiler version pinned in build.zig.zon",
      "managerFilePatterns": ["/(^|/)build\\.zig\\.zon$/"],
      "matchStrings": [
        "\\.minimum_zig_version[ \\t]*=[ \\t]*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "zig",
      "packageNameTemplate": "ziglang/zig",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ]
}
