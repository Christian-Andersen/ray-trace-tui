{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Group updates to Nix flake inputs into a single PR",
      "matchManagers": ["nix"],
      "groupName": "Nix flake inputs",
      "groupSlug": "nix-flake-inputs",
      "commitMessageTopic": "Nix flake inputs"
    }
  ]
}
