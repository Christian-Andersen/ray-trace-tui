{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Group updates to Nix flake inputs into a single PR",
      "matchManagers": ["nix"],
      "groupName": "Nix flake inputs",
      "groupSlug": "nix-flake-inputs",
      "commitMessageTopic": "Nix flake inputs"
    }
  ],
  "customManagers": [
    {
      "description": "Track the minimum Zig compiler version pinned in build.zig.zon",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)build\\.zig\\.zon$/"],
      "matchStrings": [
        "\\.minimum_zig_version[ \\t]*=[ \\t]*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "zig",
      "packageNameTemplate": "ziglang/zig",
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "semver"
    }
  ]
}
